# Copy to .env and fill in. Never commit .env.
# MLflow (DagsHub): https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Model served by the app
MODEL_NAME=sms-spam
MODEL_ALIAS=champion

# JSON logs on stdout: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Monitoring stack (docker compose): Grafana login and email for the alerts.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# SMTP (Gmail app password or Mailtrap sandbox); keep GF_SMTP_ENABLED=false without it.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=
# Use prometheus.prod.yml to scrape the production URL instead of the local API (demo).
PROMETHEUS_CONFIG=prometheus.yml

# Local port (Render injects its own PORT)
PORT=8000

# DVC remote (prefer `dvc remote modify --local azure connection_string ...`)
AZURE_STORAGE_CONNECTION_STRING=
